# Copy this file to .env and adjust values for local development.
# Do not commit .env files. Do not put secrets in source code.

CORS_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=8000

# SQLite file is created under backend/data/ by default.
# Override only if you need a different location.
# DATABASE_URL=sqlite:///C:/path/to/backend/data/app.db
